APP_NAME="OpenMMO Control"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Bases OpenMMO. En local, ce sont les ports exposés par docker-compose à la racine.
OPENMMO_LOGIN_DB_CONNECTION=pgsql
OPENMMO_LOGIN_DB_HOST=127.0.0.1
OPENMMO_LOGIN_DB_PORT=20011
OPENMMO_LOGIN_DB_DATABASE=openmmo_login_db
OPENMMO_LOGIN_DB_USERNAME=openmmo_login_user
OPENMMO_LOGIN_DB_PASSWORD=changeMe!
OPENMMO_LOGIN_DB_SSLMODE=prefer

OPENMMO_GAME_DB_CONNECTION=pgsql
OPENMMO_GAME_DB_HOST=127.0.0.1
OPENMMO_GAME_DB_PORT=20021
OPENMMO_GAME_DB_DATABASE=openmmo_game_db
OPENMMO_GAME_DB_USERNAME=openmmo_game_user
OPENMMO_GAME_DB_PASSWORD=changeMe!
OPENMMO_GAME_DB_SSLMODE=prefer

# Adresses testées par le tableau de bord.
OPENMMO_LOGIN_HOST=127.0.0.1
OPENMMO_LOGIN_PORT=2106
OPENMMO_GAME_HOST=127.0.0.1
OPENMMO_GAME_PORT=7777

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
