# Copy this file to `.env` and adjust the values for your environment.
# `.env` is gitignored and must never be committed.

LOGIN_DB_HOST=localhost
LOGIN_DB_PORT=20011
LOGIN_DB_NAME=openmmo_login_db
LOGIN_DB_USER=openmmo_login_user
LOGIN_DB_PASSWORD=changeMe!
LOGIN_DB_SEED_DEV=true

# Address the login server advertises to clients for the game server.
OPENMMO_GAME_SERVER_IPV4=127.0.0.1
OPENMMO_GAME_SERVER_IPV6=::1
OPENMMO_GAME_SERVER_PORT=7777
OPENMMO_GAME_SERVER_HOSTNAME=localhost
OPENMMO_GAME_SERVER_MAX_PLAYERS=100

# Local PokeMMO installation used by `./gradlew :patcher:run`.
# Windows example: C:/Program Files/PokeMMO/PokeMMO.exe and C:/Program Files/PokeMMO
# macOS example: /Users/you/Library/Application Support/com.pokeemu.macos/pokemmo-client-live/bin/macos/arm64/PokeMMO
POKEMMO_EXECUTABLE=
POKEMMO_WORKING_DIR=
OPENMMO_LOGIN_HOST=51.91.242.55

GAME_DB_HOST=localhost
GAME_DB_PORT=20021
GAME_DB_NAME=openmmo_game_db
GAME_DB_USER=openmmo_game_user
GAME_DB_PASSWORD=changeMe!
GAME_DB_SEED_DEV=true

OPENMMO_SESSION_SECRET=

# Private key for both servers. Leave empty for development, set one in production.
OPENMMO_GAME_PRIVATE_KEY=
OPENMMO_GAME_PRIVATE_KEY_FILE=
